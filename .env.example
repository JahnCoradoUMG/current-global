# === Backend (apps/api) ===
# Copiar a apps/api/.env para desarrollo local
NODE_ENV=development
PORT=3001

# PostgreSQL — valores alineados con docker-compose.yml
# Levantar BD: npm run db:up  (o docker compose up -d)
DATABASE_URL=postgresql://current:current@localhost:5432/current_global?schema=public

# Auth
JWT_SECRET=change_me_to_a_long_random_string_min_32_chars
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# CORS — origen del frontend (coma-separado si hay varios)
CORS_ORIGIN=http://localhost:3000

# Cloudinary (uploads de media)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# === Frontend (apps/web) ===
# Copiar a apps/web/.env.local
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_WS_URL=http://localhost:3001
