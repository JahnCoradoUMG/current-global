{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": {
          "allowJs": true,
          "esModuleInterop": true,
          "isolatedModules": true
        }
      }
    ]
  },
  "transformIgnorePatterns": [
    "node_modules/(?!(@nestjs/jwt|@nestjs/passport)/)"
  ]
}
